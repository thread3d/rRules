# API Configuration
# Dev: relative '/v1' is forwarded by the vite proxy (server.proxy['/v1']) to the
# backend at http://localhost:8080. Override with an absolute URL to bypass the
# proxy (D-22-05).
VITE_API_URL=/v1

# App Configuration
VITE_APP_NAME="rRules"
VITE_APP_VERSION="4.0.0"

# Feature Flags
VITE_ENABLE_DEV_TOOLS=true

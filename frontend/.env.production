# API Configuration
# Prod (same-origin default, Phase 21 single-container): relative '/v1' is served by
# the backend at root. Override with an absolute URL (e.g. https://api.rrules.example.com/v1)
# for a separate API host, which requires CORS (actix-cors) — see D-22-05.
VITE_API_URL=/v1

# App Configuration
VITE_APP_NAME="rRules"
VITE_APP_VERSION="4.0.0"

# Feature Flags
VITE_ENABLE_DEV_TOOLS=false

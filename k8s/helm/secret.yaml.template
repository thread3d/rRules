# rRules Secret Template
#
# This file should be rendered with helm-values-secrets.yaml for production.
# DO NOT commit the actual secret values to version control.
#
# Generate with: kubectl create secret generic rrules-secrets \
#   --from-literal=DATABASE_URL='...' \
#   --from-literal=API_SECRET_KEY='...' \
#   --dry-run=client -o yaml > k8s/helm/secret.yaml

apiVersion: v1
kind: Secret
metadata:
  name: rrules-secrets
  namespace: {{ .Release.Namespace }}
type: Opaque
stringData:
  # Database connection string
  # Format: postgresql://user:password@host:port/database
  DATABASE_URL: {{ .Values.database.secretUrl | default "postgresql://user:pass@localhost:5432/rrules" }}

  # API secret key for signing tokens and session management
  # Generate with: openssl rand -base64 32
  API_SECRET_KEY: {{ .Values.api.secretKey | default "generate-a-secure-random-key-with-openssl-rand-32" }}

# ── Rust / Cargo ──────────────────────────────────────────────
/target/
**/*.rs.bk

# ── Node / frontend ───────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
/node_modules/

# ── DMN runtime artifacts (document store writes these at runtime) ──
api/dmn/

# ── Planning research cache (local only) ─────────────────────
.planning/research/.cache/

# ── cargo-fuzz build output / corpus / crash artifacts ────────
engine/fuzz/target/
engine/fuzz/corpus/
engine/fuzz/artifacts/

# ── Memory regression-gate current snapshot (run artifact; only the
#    frozen v6.0-baseline.json is committed) ────────────────────
engine/benches/snapshots/v6.0-current.json

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*

# ── Codebase-memory MCP index (local only) ────────────────────
.codebase-memory/

# ── OS / editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
# ── CodeWitness run artifacts (local only) ────────────────────
.codewitness/

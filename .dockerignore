# Build context for the server image. The Dockerfile copies only what it compiles
# and serves, so keep this list aligned with it: a context that includes `target/`
# or a dependency tree costs minutes per build and buys nothing.

# Build artifacts and dependency trees
target/
**/target/
node_modules/
**/node_modules/
frontend/dist/
*.rlib
*.o
*.d

# Version control and editor files
.git/
.gitignore
.idea/
.vscode/
*.swp
*.swo
*~

# Local run artifacts (see .gitignore)
api/dmn/
.codewitness/
.codebase-memory/
engine/benches/snapshots/*-current.json
*.log
coverage/
.tarpaulin.html

# CI and deployment configuration — not part of the image
.github/
.gitlab-ci.yml
.travis.yml
helm/
k8s/

# Documentation and process history — not part of the image
docs/
specs/
planning/
*.md
!frontend/README.md

# Local secrets and environment files
.env
.env.*
